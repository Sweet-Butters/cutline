{
  "name": "cutline",
  "displayName": "Cutline",
  "description": "An agent-editable video timeline beside your code",
  "version": "0.1.0",
  "publisher": "cutline-local",
  "license": "MIT",
  "engines": {
    "vscode": "^1.100.0"
  },
  "main": "./out/extension.js",
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "workspaceContains:timeline.json"
  ],
  "contributes": {
    "commands": [
      {
        "command": "cutline.open",
        "title": "Open Video Panel"
      },
      {
        "command": "cutline.import",
        "title": "Import Video Sources"
      },
      {
        "command": "cutline.export",
        "title": "Export Video"
      },
      {
        "command": "cutline.askAgent",
        "title": "Ask agent: Open Chat"
      }
    ],
    "configuration": {
      "title": "Cutline",
      "properties": {
        "cutline.autoOpenPanel": {
          "type": "boolean",
          "default": true,
          "description": "Automatically open timeline.json and the Video Panel when opening a video project."
        },
        "cutline.openTerminal": {
          "type": "boolean",
          "default": false,
          "description": "Open a terminal at the project root below the timeline editor."
        },
        "cutline.autoCommitAgentEdits": {
          "type": "boolean",
          "default": true,
          "description": "Commit timeline.json after agent saves."
        },
        "cutline.codexSandbox": {
          "type": "string",
          "enum": [
            "workspace-write",
            "danger-full-access"
          ],
          "default": "danger-full-access",
          "description": "This Windows build uses danger-full-access because workspace-write tested read-only. This mode does NOT confine writes to the project. Switch to workspace-write on supported installations."
        }
      }
    },
    "configurationDefaults": {
      "files.exclude": {
        "**/.cutline-cache": true,
        "**/.git": true,
        "**/.timeline-*.tmp": true,
        "**/node_modules": true
      }
    }
  },
  "scripts": {
    "build": "tsc -p .",
    "test": "npm run build && node --test out/test/unit.js",
    "sample": "npm run build && node out/tools/sample.js",
    "test:integration": "npm run build && node out/test/run.js",
    "prepackage": "node -e \"require('node:fs').mkdirSync('dist', { recursive: true })\"",
    "package": "npm run build && vsce package --no-dependencies --allow-missing-repository --no-rewrite-relative-links --out dist/cutline.vsix",
    "test:agents": "npm run build && node tools/test-real-agents.js"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/vscode": "^1.100.0",
    "typescript": "^5.9.0",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.6.0"
  }
}
